# cp .env.example .env 후 채우기. 실제 값은 절대 커밋하지 않는다.

# VPS 공인 IP 기반 무료 도메인(sslip.io) 또는 보유 도메인.
# 예: IP가 203.0.113.10이면 → 203.0.113.10.sslip.io
#     (api.203.0.113.10.sslip.io 처럼 서브도메인이 자동으로 그 IP로 풀린다)
DEMO_DOMAIN=

# openssl rand -hex 24 로 생성
DB_PASSWORD=
MINIO_PASSWORD=
JWT_SECRET=

# Brevo(brevo.com) 가입 → SMTP & API 메뉴에서 발급
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Brevo에 등록한 발신자 주소와 일치해야 함
MAIL_FROM=LUNOTE <you@example.com>

# 선택 — Sentry 프로젝트가 있으면
SENTRY_DSN=
