# .env로 복사해서 사용: cp .env.example .env
# 프로덕션 값은 AWS Secrets Manager가 원천이다. 실제 시크릿을 여기 적지 말 것.
DATABASE_URL="postgresql://lunote:lunote_local@localhost:5432/lunote?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32"
# 쉼표 구분. 비우면 CORS 차단 (모바일 앱은 Origin을 안 보내므로 무관)
CORS_ORIGINS=""
# 기본 127.0.0.1 (로컬 전용). 실기기 테스트 시 0.0.0.0, 프로덕션(K8s)은 반드시 0.0.0.0
HOST="127.0.0.1"
# 로컬은 MinIO(docker compose). 프로덕션은 실제 S3 — ENDPOINT 비우고 IRSA 사용
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lunote-attachments"
S3_ACCESS_KEY="lunote"
S3_SECRET_KEY="change-me-not-needed-with-irsa"
# 로컬은 Mailpit(docker compose, UI: http://localhost:8025). 프로덕션은 SES SMTP
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="LUNOTE <noreply@lunote.app>"

# --- 정책 튜닝값 (선택 — 기본값은 src/config/env.validation.ts POLICY_DEFAULTS) ---
# JWT_EXPIRES="30m"
# REFRESH_TTL_DAYS=30
# AUTH_CODE_TTL_MIN=15
# AUTH_CODE_MAX_ATTEMPTS=5
# AUTH_RESEND_COOLDOWN_SEC=60
# PRESIGN_UPLOAD_TTL_SEC=300
# PRESIGN_DOWNLOAD_TTL_SEC=3600
# --- 관측 (선택) ---
# SENTRY_DSN=""   # 미설정이면 Sentry 비활성
# LOG_LEVEL="info"
